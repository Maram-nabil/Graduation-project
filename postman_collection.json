            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"newPassword\": \"newpassword123\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/auth/setNewPassword?token=reset_token_here",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "setNewPassword"],
              "query": [{ "key": "token", "value": "reset_token_here" }]
            }
          }
        },
        {
          "name": "Get Profile",
